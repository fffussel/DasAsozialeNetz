	<!-- UI depends on Logic as a plain library jar to reuse its DTOs in Feign clients.
         The root POM binds spring-boot-maven-plugin's repackage goal to every module, which
         would otherwise turn Logic's installed jar into an executable fat jar (classes nested
         under BOOT-INF/classes) and break that dependency. Repackaging still happens here, just
         under a separate "exec" classifier so the plain jar stays a normal library artifact. -->
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>repackage</id>
						<configuration>
							<classifier>exec</classifier>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>